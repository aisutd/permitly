# Copy this file to .env and fill it in. NEVER commit .env (it is in .gitignore).

# --- LLM (free option: Google Gemini, key from https://aistudio.google.com/apikey) ---
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.0-flash
LLM_TIMEOUT_SECONDS=15
LLM_RETRY_WAIT_SECONDS=5

# --- Web server ---
# Frontend addresses allowed to call this API, comma separated (no spaces needed).
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
MAX_DESCRIPTION_CHARS=2000
RATE_LIMIT_PER_MINUTE=20
# Set to true on Render / Railway / Fly (they sit behind a proxy)
TRUST_PROXY=false

# --- Supabase (optional while developing) ---
# Project Settings -> API. The SERVICE key is a SECRET: backend only, never in the frontend.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
LOG_TO_SUPABASE=false

# Load the embedding model at startup (only needed for embeddings / future RAG)
PRELOAD_EMBEDDINGS=false
